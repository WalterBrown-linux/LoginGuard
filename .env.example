# Required for login email alerts
EMAIL_USER=your-sending-account@example.com
EMAIL_APP_PASSWORD=replace_with_an_app_specific_password
ALERT_TO=your-private-alert-address@example.com

# Mail provider endpoints (Gmail defaults are shown)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
IMAP_HOST=imap.gmail.com

# Optional email-to-SMS gateway destination; leave blank to disable
SMS_TO=

# Privacy-sensitive features are disabled by default
CAPTURE_PHOTO=false
CAMERA_INDEX=0
KEEP_PHOTOS=false
IP_LOCATION_ENABLED=false
IPINFO_TOKEN=

# Remote commands are disabled by default
REMOTE_COMMANDS_ENABLED=false
COMMAND_FROM=your-trusted-command-sender@example.com
COMMAND_SECRET=
DEVICE_ID=
ALLOWED_ACTIONS=LOCK
POLL_SECONDS=30
COMMAND_MAX_AGE_SECONDS=300
MAX_COMMAND_CANDIDATES=20
MAX_COMMAND_HEADER_BYTES=16384
MAX_SAVED_PHOTOS=10
